# =============================================================================
# VNtyper Online - Environment Template
# =============================================================================
# Copy this file to .env.local for local development or .env.production for prod.
# DO NOT commit real secrets or credentials to version control.
# =============================================================================

# Environment ('local', 'development', or 'production')
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Redis Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Password for the Redis instance shared by the API, worker, and beat.
# There is NO default: process startup will fail if this is unset.
# Generate a fresh secret using:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Celery URLs (Redis password should match REDIS_PASSWORD above)
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# -----------------------------------------------------------------------------
# Pseudonymisation key (REQUIRED in production)
# -----------------------------------------------------------------------------
# HMAC key for the usage-statistics caller hash. Every service reads this file,
# so the API and all workers share one value. Unset, each process uses a random
# key and production logs an ERROR at startup. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PSEUDONYM_SECRET=

# -----------------------------------------------------------------------------
# Backend image (optional)
# -----------------------------------------------------------------------------
# Production defaults to a digest-pinned release (see docker-compose.yml), so a
# redeploy never picks up a moving tag. Override only to roll forward deliberately.
# VNTYPER_IMAGE=ghcr.io/vntyper-org/vntyper:2.0.51@sha256:7f8b75af99f5e99283bfcf9828ba5874dc1e0d23dff7656346910f8c8bdf14ff

# -----------------------------------------------------------------------------
# Storage & Volumes
# -----------------------------------------------------------------------------
INPUT_VOLUME=/opt/vntyper/input
OUTPUT_VOLUME=/opt/vntyper/output
MAX_RESULT_AGE_DAYS=3
MAX_UPLOAD_BYTES=1073741824

# -----------------------------------------------------------------------------
# Domain & Web Server
# -----------------------------------------------------------------------------
SERVER_NAME=localhost
DOMAIN=localhost
CLIENT_MAX_BODY_SIZE=100M

# -----------------------------------------------------------------------------
# Certbot (SSL)
# -----------------------------------------------------------------------------
CERTBOT_EMAIL=admin@example.com
CERTBOT_STAGING=1

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL for anonymous research donations)
# -----------------------------------------------------------------------------
# docker-compose.yml builds the API's POSTGRES_URL from these values, so keep
# the password URL-safe (token_urlsafe output is). With ENABLE_DONATIONS=true
# the API refuses to start when it cannot reach this database.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vntyper_donations
POSTGRES_USER=vntyper_user
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Anonymous research donations (disabled by default; needs PostgreSQL above)
ENABLE_DONATIONS=false

# Default state of the adVNTR and normal-mode checkboxes (both on by default).
# Also applies to API submissions that do not send advntr_mode.
DEFAULT_ADVNTR_MODE=true
DEFAULT_NORMAL_MODE=true
